<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Booking Verification OTP</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f7f6;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f7f6;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;">
          <tr>
            <td style="background:#0d9488;padding:28px 32px;text-align:center;">
              <p style="margin:0;font-size:24px;font-weight:700;color:#ffffff;">Pathologia</p>
              <p style="margin:8px 0 0;font-size:13px;color:#ccfbf1;">Booking verification</p>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <p style="margin:0 0 12px;font-size:16px;">Hello {{patientName}},</p>
              <p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#4b5563;">
                <strong>{{pathologistName}}</strong> is booking pathology tests on your behalf on Pathologia.
                Use the OTP below to authorize this booking.
              </p>
              <div style="text-align:center;margin:28px 0;">
                <span style="display:inline-block;padding:16px 32px;background:#f0fdfa;border:2px dashed #0d9488;border-radius:12px;font-size:32px;font-weight:700;letter-spacing:8px;color:#0f766e;">{{otp}}</span>
              </div>
              <p style="margin:0;font-size:14px;color:#6b7280;">This OTP expires on <strong>{{expiresAt}}</strong>. Do not share it with anyone.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
