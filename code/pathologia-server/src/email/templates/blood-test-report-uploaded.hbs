<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8" /><title>Report Uploaded</title></head>
<body style="margin:0;padding:32px 16px;font-family:Arial,sans-serif;background:#f4f7f6;color:#1f2937;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr><td align="center">
      <table role="presentation" width="600" style="max-width:600px;background:#fff;border-radius:12px;padding:32px;">
        <tr><td>
          <p style="margin:0 0 8px;font-size:22px;font-weight:700;color:#0d9488;">Pathologia</p>
          <p style="margin:0 0 16px;font-size:16px;">Hello {{patientName}},</p>
          <p style="margin:0 0 12px;font-size:15px;line-height:1.6;">Your blood test report for <strong>{{testName}}</strong> has been uploaded.</p>
          <p style="margin:0 0 8px;font-size:14px;color:#4b5563;">File: <strong>{{fileName}}</strong></p>
          <p style="margin:0;font-size:14px;color:#4b5563;">Log in to Pathologia to view or download your report.</p>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
