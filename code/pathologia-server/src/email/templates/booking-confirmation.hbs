<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Booking Confirmed</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f7f6;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f7f6;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;">
          <tr>
            <td style="background:#0d9488;padding:28px 32px;text-align:center;">
              <p style="margin:0;font-size:24px;font-weight:700;color:#ffffff;">Pathologia</p>
              <p style="margin:8px 0 0;font-size:13px;color:#ccfbf1;">Test booking confirmed</p>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <p style="margin:0 0 12px;font-size:16px;">Hello {{patientName}},</p>
              <p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#4b5563;">
                Your pathology test booking has been confirmed by <strong>{{bookedByName}}</strong>.
              </p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;">
                <tr>
                  <td style="padding:16px;">
                    <p style="margin:0 0 8px;font-size:14px;"><strong>Appointment:</strong> {{scheduledAt}}</p>
                  </td>
                </tr>
              </table>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:8px;overflow:hidden;">
                <tr style="background:#f9fafb;">
                  <th style="padding:10px 12px;text-align:left;font-size:13px;">Test</th>
                  <th style="padding:10px 12px;text-align:right;font-size:13px;">Rate</th>
                </tr>
                {{{testsHtml}}}
                <tr style="background:#f0fdfa;">
                  <td style="padding:12px;font-weight:700;">Total</td>
                  <td style="padding:12px;text-align:right;font-weight:700;">{{totalAmount}}</td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
